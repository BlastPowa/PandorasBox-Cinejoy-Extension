{
  "manifest_version": 3,
  "name": "PBox Watch Sync",
  "version": "1.2.2",
  "description": "Tracks movie and episode playback across Cinejoy, CinemaOS, Netflix, Prime Video and compatible HTML5 players, with Cinejoy list sync.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
